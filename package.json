{
  "name": "reminders-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling macOS Reminders",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && npm run build:helper && tsc",
    "start": "node dist/index.js",
    "build:helper": "mkdir -p bin && swiftc -O -enable-bare-slash-regex helper/main.swift -o bin/reminders-helper"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "reminders-mcp": "dist/index.js"
  }
}
