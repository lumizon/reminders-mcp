{
  "name": "@lumizon/macos-mcp",
  "version": "1.1.0",
  "description": "MCP server for macOS apps: Reminders, Calendar and Notes",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && npm run build:helper && tsc",
    "start": "node dist/index.js",
    "build:helper": "mkdir -p bin && swiftc -O -enable-bare-slash-regex helper/main.swift -o bin/macos-helper"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macos",
    "reminders",
    "calendar",
    "notes",
    "eventkit"
  ],
  "author": "Loïc Ernult",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumizon/macos-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "macos-mcp": "dist/index.js"
  }
}
